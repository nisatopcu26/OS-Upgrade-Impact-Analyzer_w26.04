"""M2 / Sprint 3 — Ubuntu çoklu sürüm scraper'ı.

Sürüme göre doğru URL ve doğru parser'ı seçer (yeni Sphinx / eski wiki).
"""

import json
import time
from pathlib import Path

from src.scraper.base_scraper import (
    fetch_page,
    save_raw_html,
    parse_release_notes,
    parse_wiki_release_notes,
)

CONFIG_PATH = Path("config/versions.json")

# format adı -> parser fonksiyonu
PARSERS = {
    "sphinx": parse_release_notes,
    "wiki": parse_wiki_release_notes,
}


def _load_config() -> dict:
    return json.loads(CONFIG_PATH.read_text(encoding="utf-8"))


def get_version_config(version: str) -> dict:
    """Sürümün {url, format} ayarını döner. Yoksa anlamlı hata fırlatır."""
    versions = _load_config()["versions"]
    if version not in versions:
        raise ValueError(
            f"Desteklenmeyen sürüm: {version!r}. "
            f"Desteklenenler: {list(versions)}"
        )
    return versions[version]


def scrape_version(version: str) -> list[dict]:
    """URL(ler) üret -> fetch -> kaydet -> doğru parser ile parse.

    extra_urls (varsa): aynı sürümün ek alt sayfaları (ör. 26.04'ün
    "summary-for-lts-users/" sayfası gibi, Canonical içeriği ana sayfadan
    ayrı bir URL'e taşıdığında). Her ek sayfa ayrı fetch edilir, section_id
    çakışmasını önlemek için sayfa sırasına göre önek eklenir.
    """
    cfg = get_version_config(version)
    parser = PARSERS[cfg["format"]]

    urls = [cfg["url"]] + list(cfg.get("extra_urls", []))
    all_sections = []

    for page_idx, url in enumerate(urls):
        html = fetch_page(url)
        if html is None:
            print(f"[WARN] {version}: sayfa çekilemedi, atlanıyor ({url})")
            continue

        suffix = "" if page_idx == 0 else f"_extra{page_idx}"
        save_raw_html(html, version, suffix=suffix)

        sections = parser(html, version=version, source_url=url)

        if not sections:
            print(f"[WARN] {version}: hiç bölüm ayrıştırılamadı — "
                  f"sayfa yapısı değişmiş olabilir ({url})")
            continue

        if page_idx > 0:
            for s in sections:
                if s.get("section_id"):
                    s["section_id"] = f"p{page_idx}-{s['section_id']}"

        all_sections.extend(sections)
        time.sleep(1)   # kibarlık

    if not all_sections:
        raise RuntimeError(f"Hiçbir sayfadan bölüm elde edilemedi: {version}")

    return all_sections
