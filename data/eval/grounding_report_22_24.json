        }
      ],
      "flags": []
    },
    {
      "text": "The PostgreSQL package in Ubuntu 24.04 includes the SQL standard MERGE command, which can be used to perform conditional SQL statements including INSERT, DELETE, and UPDATE actions.",
      "chunk_ids": [
        "24.04_postgresql_0",
        "24.04_postgresql_1"
