          "scraped_at": "2026-08-17T09:39:26.639509"
        }
      ],
      "flags": []
    },
    {
      "text": "The HAProxy package in Ubuntu 24.04 introduces a new global setting to limit the total number of HTTP/2 streams per client connection, which can be configured using 'tune.h2.fe.max-total-streams'.",
      "chunk_ids": [
        "24.04_haproxy_0",
        "news-debian_24.04_haproxy"
      ],
      "category": "package",
      "affected_package": "haproxy",
      "support_score": 0.873,
      "sources": [
        {
          "chunk_id": "24.04_haproxy_0",
