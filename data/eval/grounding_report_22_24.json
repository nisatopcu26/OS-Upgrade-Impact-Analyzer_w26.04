          "scraped_at": "2026-08-17T09:39:26.639509"
        }
      ],
      "flags": []
    },
    {
      "text": "The systemd package in Ubuntu 24.04 is now enabled by default, even when the instance is launched directly from a terminal.",
      "chunk_ids": [
        "apt-relations_24.04_systemd"
      ],
      "category": "package",
      "affected_package": "systemd",
      "support_score": 0.685,
      "sources": [
