          "chunk_id": "24.04_docker_0",
          "url": "https://documentation.ubuntu.com/release-notes/24.04/",
          "scraped_at": "2026-08-17T09:39:26.639509"
        }
      ],
      "flags": []
    },
    {
      "text": "The upgrade process will now systematically restart services affected by library upgrades, including in non-interactive scenarios such as unattended-upgrade.",
      "chunk_ids": [
        "24.04_services-restart-on-unattended-upgrade_0"
      ],
      "category": "general",
      "affected_package": null,
