          "scraped_at": "2026-08-24T11:57:55.891376+00:00"
        }
      ],
      "flags": []
    },
    {
      "text": "The ClamAV package in Ubuntu 24.04 now supports unpacking CVD signature archives and has added a new callback for inspecting file content during scans.",
