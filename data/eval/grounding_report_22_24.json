          "scraped_at": "2026-08-17T09:39:26.639509"
        }
      ],
      "flags": []
    },
    {
      "text": "The known issue with AppArmor in Docker may cause containers to be killed with SIGKILL due to denials when trying to receive a signal, requiring users to apply the provided workaround.",
      "chunk_ids": [
        "24.04_docker_0"
      ],
      "category": "known_issue",
      "affected_package": null,
      "support_score": 0.809,
      "sources": [
