          "scraped_at": "2026-08-17T09:39:26.639509"
        }
      ],
      "flags": []
    },
    {
      "text": "The Samba package in Ubuntu 24.04 has been updated to the 4.19.x series, and its VFS modules are now split into samba-vfs-modules and samba-vfs-modules-extra.",
      "chunk_ids": [
        "24.04_samba_0",
        "24.04_glusterfs_1"
      ],
      "category": "package",
      "affected_package": "samba",
      "support_score": 0.873,
      "sources": [
        {
          "chunk_id": "24.04_samba_0",
          "url": "https://documentation.ubuntu.com/release-notes/24.04/",
          "scraped_at": "2026-08-17T09:39:26.639509"
