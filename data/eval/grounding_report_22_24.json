      "flags": []
    },
    {
      "text": "The upgrade from Ubuntu 22.04 to 24.04 will introduce a known issue with the AppArmor profile for runc in Docker, where containers cannot be promptly stopped due to deprecation warnings.",
      "chunk_ids": [
        "24.04_docker_0"
