          "chunk_id": "news-debian_24.04_haproxy",
          "url": "news-debian:haproxy",
          "scraped_at": "2026-08-24T11:57:55.891376+00:00"
        }
      ],
      "flags": []
    },
    {
      "text": "The Squid package in Ubuntu 24.04 now logs communication details for TLS connections and has removed support for the Gopher protocol.",
      "chunk_ids": [
        "24.04_squid_0"
      ],
      "category": "package",
      "affected_package": "squid",
      "support_score": 0.881,
      "sources": [
        {
          "chunk_id": "24.04_squid_0",
          "url": "https://documentation.ubuntu.com/release-notes/24.04/",
          "scraped_at": "2026-08-17T09:39:26.639509"
        }
      ],
      "flags": []
    },
    {
      "text": "The SSSD package in Ubuntu 24.04 now supports ldapi:// URLs for connections to local LDAP servers and has deprecated the 'Files provider' with a recommendation to use the 'Proxy provider'.",
      "chunk_ids": [
        "24.04_sssd_0"
      ],
      "category": "package",
      "affected_package": "sssd",
      "support_score": 0.801,
      "sources": [
