          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "The samba-vfs-modules package is now just a transitional package and can be safely removed after the release upgrade.",
      "chunk_ids": [
        "26.04_samba-src1_1"
      ],
      "category": "package",
      "affected_package": "samba-vfs-modules",
      "support_score": 0.919,
      "sources": [
        {
