  "summary": "Upgrading from Ubuntu 24.04 to 26.04 may require manual steps for RabbitMQ and Samba due to feature flags and package splits.",
  "claims": [
    {
      "text": "PostgreSQL was updated to version 18, which improves performance for workloads of all sizes through a new I/O subsystem.",
      "chunk_ids": [
        "26.04_postgresql-src1_0"
      ],
      "category": "package",
