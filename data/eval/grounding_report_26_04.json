          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "ClamAV was updated to 1.4.3 with many new features, including scanning attachments found in Microsoft OneNote section files and extracting Universal Disk Format (UDF) partitions.",
      "chunk_ids": [
        "26.04_clamav-src1_0"
      ],
      "category": "package",
      "affected_package": "clamav",
      "support_score": 0.866,
