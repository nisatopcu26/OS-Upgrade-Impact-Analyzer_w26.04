  "summary": "Upgrading from Ubuntu 24.04 to 26.04 may require manual steps for RabbitMQ and Postfix, while PostgreSQL has been updated to version 18 with improved performance.",
  "claims": [
    {
      "text": "PostgreSQL was updated to version 18 in Ubuntu 26.04.",
      "chunk_ids": [
        "26.04_postgresql-src1_0"
      ],
      "category": "general",
      "affected_package": null,
      "support_score": 0.918,
      "sources": [
        {
          "chunk_id": "26.04_postgresql-src1_0",
          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "The new PostgreSQL version improves performance for workloads of all sizes through a new I/O subsystem that has demonstrated up to 3× performance improvements when reading from storage.",
      "chunk_ids": [
        "26.04_postgresql-src1_0"
      ],
      "category": "general",
      "affected_package": null,
      "support_score": 0.852,
      "sources": [
        {
          "chunk_id": "26.04_postgresql-src1_0",
          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "PostgreSQL 18 makes major-version upgrades less disruptive, accelerating upgrade times and reducing the time required to reach expected performance after an upgrade completes.",
      "chunk_ids": [
        "26.04_postgresql-src1_0"
      ],
      "category": "general",
      "affected_package": null,
      "support_score": 0.854,
      "sources": [
        {
          "chunk_id": "26.04_postgresql-src1_0",
          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "RabbitMQ is not directly upgradable due to feature flags, requiring manual steps for mitigation.",
      "chunk_ids": [
        "26.04_rabbitmq-src1_0"
      ],
      "category": "known_issue",
      "affected_package": "rabbitmq",
      "support_score": 0.9,
      "sources": [
        {
          "chunk_id": "26.04_rabbitmq-src1_0",
          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "The samba-vfs-modules package is now just a transitional package, and it can be safely removed after the release upgrade.",
      "chunk_ids": [
        "26.04_samba-src1_0"
      ],
      "category": "general",
      "affected_package": "samba",
      "support_score": 0.722,
      "sources": [
        {
          "chunk_id": "26.04_samba-src1_0",
          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": [
        {
          "term": "transitional",
          "reason": "term_not_in_cited_source"
        }
      ]
    },
    {
      "text": "Samba has been updated to the new upstream 4.23 version in Ubuntu 26.04 LTS.",
      "chunk_ids": [
        "26.04_samba-src1_0"
      ],
      "category": "general",
      "affected_package": "samba",
      "support_score": 0.795,
