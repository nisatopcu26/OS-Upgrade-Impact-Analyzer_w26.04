          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "Chrony is now used as the default time daemon replacing systemd-timesyncd for new installations, and NTS (authenticated & encrypted NTP) by default uses Ubuntu time servers.",
      "chunk_ids": [
        "26.04_chrony-src1_0"
      ],
      "category": "package",
      "affected_package": "chrony",
      "support_score": 0.964,
      "sources": [
        {
