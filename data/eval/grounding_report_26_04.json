          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "Ubuntu now comes with the upstream tmp.mount unit by default, making /tmp a tmpfs file system by default.",
      "chunk_ids": [
        "26.04_systemd-259-src1_0"
      ],
      "category": "general",
