          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "Postfix is no longer installed in a chroot by default and only limited chroot support is available from now on.",
      "chunk_ids": [
        "26.04_postfix-src1_0"
      ],
      "category": "known_issue",
