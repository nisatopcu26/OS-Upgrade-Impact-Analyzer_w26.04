          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "Django has been updated to the latest LTS release 5.2 from 4.2, which includes many new features and bug fixes.",
      "chunk_ids": [
        "26.04_django-src1_0"
      ],
      "category": "package",
      "affected_package": "django",
      "support_score": 0.938,
      "sources": [
