          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "Samba has been updated to the new upstream 4.23 version, which includes SMB3 Unix Extensions enabled by default and NetBios disabled by default.",
      "chunk_ids": [
        "26.04_samba-src1_0"
      ],
      "category": "package",
      "affected_package": "samba",
      "support_score": 0.851,
      "sources": [
        {
          "chunk_id": "26.04_samba-src1_0",
          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "HAProxy was updated to the latest upstream LTS release, 3.2, which introduces performance and efficiency improvements, faster and more reliable QUIC protocol support.",
      "chunk_ids": [
        "26.04_haproxy-src1_0"
      ],
      "category": "package",
      "affected_package": "haproxy",
      "support_score": 0.912,
      "sources": [
        {
          "chunk_id": "26.04_haproxy-src1_0",
          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "Squid was updated to upstream version 7.2, which includes several bugfixes for crash scenarios and some directives and options were removed.",
      "chunk_ids": [
        "26.04_squid-src1_0"
      ],
      "category": "package",
      "affected_package": "squid",
      "support_score": 0.848,
      "sources": [
        {
          "chunk_id": "26.04_squid-src1_0",
          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "SSSD has been updated to version 2.12, which now runs under user sssd instead of root and the implicit files provider and domain was removed.",
      "chunk_ids": [
        "26.04_sssd-src1_0"
      ],
      "category": "package",
      "affected_package": "sssd",
      "support_score": 0.956,
      "sources": [
        {
          "chunk_id": "26.04_sssd-src1_0",
          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "The systemd service manager has been updated from version 255 to 259, which is the last release that supports System V service scripts compatibility in systemd.",
      "chunk_ids": [
        "26.04_systemd-259-src1_0"
      ],
      "category": "package",
      "affected_package": "systemd",
      "support_score": 0.846,
      "sources": [
        {
          "chunk_id": "26.04_systemd-259-src1_0",
          "url": "https://documentation.ubuntu.com/release-notes/26.04/summary-for-lts-users/",
          "scraped_at": "2026-08-18T15:05:47.145640"
        }
      ],
      "flags": []
    },
    {
      "text": "GCC has been updated from version 14 to 15.2, binutils from 2.42 to 2.46, and glibc from 2.39 to 2.43.",
      "chunk_ids": [
        "26.04_development-src1_0"
      ],
      "category": "package",
      "affected_package": "gcc",
      "support_score": 0.821,
      "sources": [
        {
          "chunk_id": "26.04_development-src1_0",
