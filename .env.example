# Freshness / cache (M3.5)
# TTL_DAYS=7

# RAG (M3)
# CHROMA_DIR=data/chroma
# Desteklenen modeller settings.py _PROFILES tablosunda: koleksiyon adı ve
# sorgu öneki modeli otomatik izler (S1). Varsayılan bge-small (S2 flip);
# geri dönüş: MiniLM + SIMILARITY_THRESHOLD=0.30 (iki env satırı).
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHROMA_COLLECTION=   # yalnız test/deney: profil koleksiyonunu ezmek için
# TOP_K=5
# SIMILARITY_THRESHOLD=0.60

# LLM (M4) — lokal Ollama
# LLM_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# API (M6) — 8000 bu makinede dolu olduğu için 8010
# API_BASE_URL=http://localhost:8010
